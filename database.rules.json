{
  "rules": {
    "parts": {
      "shared": {
        "$id": {
          ".write": "(!data.exists() && newData.child('k').isString() && newData.child('k').val().length >= 20 && !newData.child('prev').exists()) || (data.exists() && newData.child('prev').val() === data.child('k').val() && newData.child('k').isString() && newData.child('k').val().length >= 20 && newData.child('k').val() !== data.child('k').val())",
          "data": {
            ".read": "true",
            ".validate": "newData.hasChildren(['name', 'updatedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 120"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "prev": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "$other": {
            ".validate": "false"
          }
        }
      },
      "meshes": {
        "$id": {
          ".read": "true",
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 8400000"
        }
      }
    }
  }
}
